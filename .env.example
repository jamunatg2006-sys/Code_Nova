# Neon Memory — Mind Flip Environment Variables
# Copy this file to .env and configure your values

# Server Port (defaults to 5000 if not specified)
PORT=5000

# MongoDB Connection URI (e.g., mongodb://localhost:27017 or mongodb+srv://<username>:<password>@cluster0.mongodb.net)
MONGODB_URI=

# Database Name
DB_NAME=neon_memory_db

# Allowed CORS Origin for Frontend (e.g., http://localhost:3000, http://127.0.0.1:5500, or * for all during dev)
CLIENT_ORIGIN=*
